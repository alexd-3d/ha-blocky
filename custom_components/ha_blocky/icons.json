{
  "entity": {
    "switch": {
      "blocking": {
        "default": "mdi:shield-check",
        "state": {
          "off": "mdi:shield-off"
        }
      }
    },
    "sensor": {
      "resumes_at": {
        "default": "mdi:timer-outline"
      },
      "queries_total": {
        "default": "mdi:dns"
      },
      "blocked_total": {
        "default": "mdi:shield-remove"
      },
      "queries_24h": {
        "default": "mdi:dns"
      },
      "blocked_24h": {
        "default": "mdi:shield-remove"
      },
      "blocked_ratio_24h": {
        "default": "mdi:percent"
      },
      "clients_24h": {
        "default": "mdi:devices"
      },
      "top_domains": {
        "default": "mdi:format-list-numbered"
      },
      "top_blocked_domains": {
        "default": "mdi:format-list-numbered"
      },
      "top_clients": {
        "default": "mdi:format-list-numbered"
      },
      "list_entries": {
        "default": "mdi:format-list-checks"
      }
    },
    "button": {
      "refresh_lists": {
        "default": "mdi:playlist-check"
      },
      "flush_cache": {
        "default": "mdi:cached"
      }
    },
    "select": {
      "pause_blocking": {
        "default": "mdi:timer-pause-outline",
        "state": {
          "active": "mdi:shield-check"
        }
      }
    }
  },
  "services": {
    "disable_blocking": {
      "service": "mdi:shield-off"
    },
    "allow_domain": {
      "service": "mdi:shield-plus"
    },
    "block_domain": {
      "service": "mdi:shield-remove"
    },
    "remove_domain": {
      "service": "mdi:playlist-remove"
    },
    "get_list": {
      "service": "mdi:format-list-bulleted"
    },
    "rotate_list_token": {
      "service": "mdi:key-change"
    }
  }
}
